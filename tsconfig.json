{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@contracts/*": [
        "./contracts/*"
      ],
      "@utils/*": [
        "./utils/*"
      ],
      "@scripts/*": [
        "./scripts/*"
      ],
      "@artifacts/*": [
        "./artifacts/*"
      ],
      "@types/*": [
        "./types/*"
      ]
    },
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "outDir": "dist"
  }
}
